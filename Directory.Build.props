<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <Company>Open Partition Manager contributors</Company>
    <Product>Open Partition Manager</Product>
    <Copyright>Copyright (c) 2026 Open Partition Manager contributors. MIT licence.</Copyright>
  </PropertyGroup>
</Project>
