<Window x:Class="OpenPartition.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenPartition.Gui"
        Title="{Binding Title}" Width="1440" Height="900" MinWidth="1000" MinHeight="600"
        Icon="Assets/OpenPartition.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}" Background="{StaticResource PageBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="IssueTemplate" DataType="{x:Type local:IssueRow}">
            <DockPanel Margin="0,2">
                <TextBlock DockPanel.Dock="Left" Width="64" Text="{Binding Severity}" Foreground="{Binding Brush}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{Binding Brush}" />
            </DockPanel>
        </DataTemplate>

        <!-- A partition or free extent on the disk map: coloured usage bar on top, details below -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <DockPanel>
                                <ProgressBar x:Name="Usage" DockPanel.Dock="Top" Height="8" Margin="0" Style="{StaticResource Meter}"
                                             Foreground="{Binding Fill}" Background="{Binding Track}"
                                             Value="{Binding UsedFraction, Mode=OneWay, TargetNullValue=1}" />
                                <Grid Margin="10,7,8,6">
                                    <StackPanel>
                                        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SizeLine}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding KindLine}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               ToolTip="Some operations are refused; select for details"
                                               Visibility="{Binding HasRefusals, Converter={StaticResource Visible}}" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFree}" Value="True">
                                <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Setter TargetName="Usage" Property="Value" Value="0" />
                                <Setter TargetName="Outer" Property="Background" Value="#FAFBFC" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#AFC0D6" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsPlanned}" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource PlannedBrush}" />
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Outer" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A clickable row of the partition table -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="10,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F4F7FB" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Segment.IsSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/AppIcon-64.png" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProductName}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Disk &amp; partition manager for Windows Server and Windows · preview" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer: status, planned changes and Apply -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButton}" Content="{Binding QueueSummary}" Padding="14,7" Click="OnShowPlanClick"
                            IsEnabled="{Binding HasQueue}" AutomationProperties.Name="Planned changes" />
                    <Button Margin="10,0,0,0" Padding="20,7" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding HasQueue}" Click="OnApplyClick"
                            AutomationProperties.Name="Apply…">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                            <TextBlock Text="Apply…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="22" Height="22" Margin="0,0,10,0">
                        <Ellipse>
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllClear}" Value="False">
                                            <Setter Property="Fill" Value="#E0A100" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="11" Foreground="White" HorizontalAlignment="Center" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}" />
                        <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="760" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="236" Background="#F9FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,16">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="System information" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding SystemInfo}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DetailRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <Button Click="OnShowOverviewClick" AutomationProperties.Name="Overview">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowOverview}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="Overview" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnShowPlanClick" AutomationProperties.Name="Planned changes view">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPlan}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentBrush}" CornerRadius="10" MinWidth="22" Height="20" Padding="6,0"
                                    Visibility="{Binding HasQueue, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding QueueCount}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" Margin="0,0,12,0" />
                                <TextBlock Text="Planned changes" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Details of the selection, and what can be done with it -->
        <Border DockPanel.Dock="Right" Width="350" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,18">
                <Grid>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="36" Foreground="#B8C4D3" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Text="Select a partition or free space on the map or in the table to see its details and what can be done with it." Style="{StaticResource Muted}" />
                    </StackPanel>
                    <StackPanel DataContext="{Binding Selected}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel Margin="0,0,0,14">
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="8" Background="{Binding Track}" Margin="0,0,12,0" VerticalAlignment="Top">
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{Binding Fill}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{Binding SizeLine, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding KindLine, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Muted}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsPartition, Converter={StaticResource Visible}}">
                            <Border Background="#F7F9FC" CornerRadius="8" Padding="6">
                                <StackPanel>
                                    <Button Style="{StaticResource FlatButton}" Click="OnShadowsClick" Content="Shadow copies..." />
                                    <Button Style="{StaticResource FlatButton}" IsEnabled="{Binding CanMove}" Click="OnMoveClick" AutomationProperties.Name="Move…">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7C2;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                                            <TextBlock Text="Move…" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FlatButton}" IsEnabled="{Binding CanExtend}" Click="OnExtendClick" AutomationProperties.Name="Extend…">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE740;" Style="{StaticResource Glyph}" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" />
                                            <TextBlock Text="Extend…" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="4,8,0,0">
                                <Run Text="Move: " FontWeight="SemiBold" /><Run Text="{Binding MoveBlocked, Mode=OneWay, TargetNullValue=''}" />
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanMove}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="4,6,0,0">
                                <Run Text="Extend: " FontWeight="SemiBold" /><Run Text="{Binding ExtendBlocked, Mode=OneWay, TargetNullValue=''}" />
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanExtend}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="Properties" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DetailRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Warnings and refusals" FontWeight="SemiBold" Margin="0,18,0,6" />
                        <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueTemplate}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid>
            <!-- Overview -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowOverview, Converter={StaticResource Visible}}">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="Disk &amp; Partition Manager" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="View your disks, partitions and volumes, plan moves and extends, and preview the result before anything is applied." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,16" />

                    <!-- Machine-wide notices (Azure snapshot reminder, not elevated, ...) -->
                    <ItemsControl ItemsSource="{Binding Banners}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8E6" BorderBrush="#F2D48A" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Glyph}" Foreground="#B07800" Margin="0,0,12,0" VerticalAlignment="Top" />
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IssueTemplate}" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Interrupted moves: finish or undo before anything else changes on that disk -->
                    <ItemsControl ItemsSource="{Binding Pending}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:PendingRow}">
                                <Border Background="#FDEDEC" BorderBrush="#EBA8A2" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE783;" Style="{StaticResource Glyph}" Foreground="#B3261E" Margin="0,0,12,0" VerticalAlignment="Top" />
                                        <Button DockPanel.Dock="Right" Content="Undo…" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" Click="OnUndoMoveClick"
                                                ToolTip="Put the partition back where it was before the move" />
                                        <Button DockPanel.Dock="Right" Content="Resume…" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                                IsEnabled="{Binding CanResume}" Click="OnResumeClick" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#8C1D18" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Summary cards -->
                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,-12,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StatCard}">
                                <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Accent.Color}" Opacity="0.15" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="20" Foreground="{Binding Accent}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Disk map -->
                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DiskViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,4,10,0" ToolTip="{Binding Header}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding StyleLine}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding SizeLine}" Style="{StaticResource Muted}" />
                                                <TextBlock Text="{Binding StateLine}" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Segments}" Height="100">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <local:ProportionalPanel MinChildWidth="96" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="local:ProportionalPanel.Weight" Value="{Binding Weight}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:SegmentViewModel}">
                                                        <Button Style="{StaticResource SegmentButton}" Click="OnSegmentClick" ToolTip="{Binding Heading}" AutomationProperties.Name="{Binding Heading}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <TextBlock Text="{Binding Preview}" Foreground="{StaticResource PlannedBrush}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Preview}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueTemplate}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Partition table -->
                    <Border Style="{StaticResource Card}" Padding="0,0,0,6" Margin="0,4,0,0">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                <TextBlock Text="Partitions" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <Border Padding="20,8,20,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="2*" MinWidth="120" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="*" MinWidth="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Volume" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Label" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="File system" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Capacity" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Used" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Free" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Type" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Status" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Table}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:TableRow}">
                                        <Grid>
                                            <Border Padding="10,9,10,3" Visibility="{Binding IsHeading, Converter={StaticResource Visible}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding DiskHeading}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <Button Click="OnTableRowClick" AutomationProperties.Name="{Binding Automation}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid DataContext="{Binding Segment}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="2*" MinWidth="120" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" MinWidth="90" />
                                                        <ColumnDefinition Width="*" MinWidth="90" />
                                                        <ColumnDefinition Width="*" MinWidth="90" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="90" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="4" Height="14" RadiusX="2" RadiusY="2" Fill="{Binding Fill}" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding ColumnVolume}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ColumnLabel}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ColumnFileSystem}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding ColumnCapacity}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding ColumnUsed}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding ColumnFree}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding ColumnType}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding ColumnStatus}" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Planned changes -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowPlan, Converter={StaticResource Visible}}">
                <StackPanel Margin="24,20,24,24" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Planned changes" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,16"
                               Text="Nothing touches a disk until you click Apply. The overview shows the disks as they will be. Moving the same partition twice, or extending it twice, is merged into one step." />
                    <ItemsControl ItemsSource="{Binding Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:QueueItem}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentSoftBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Description, Mode=OneTime}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Click="OnUndoClick" AutomationProperties.Name="Undo last">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Undo last" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnClearClick" Margin="8,0,0,0" AutomationProperties.Name="Clear">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
